{
  "manifest_version": 3,
  "name": "Color Changer Extension",
  "version": "1.0",
  "description": "Click the popup to change the background color of the current page.",
  "permissions": ["scripting", "activeTab"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  },
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  }
}
